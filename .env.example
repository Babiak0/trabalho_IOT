# Copie para .env (cp .env.example .env) e troque as senhas. O .env não vai para o git.

POSTGRES_PASSWORD=troque-esta-senha

# --- Broker MQTT local (Mosquitto do docker compose) ---
MQTT_BACKEND_PASSWORD=troque-senha-backend
# Dispositivos autorizados: id:senha separados por vírgula. O id é também o usuário MQTT.
MQTT_DEVICES=esp32-sala-01:troque-senha-esp32,esp32-sim-01:troque-senha-sim
SIM_PASSWORD=troque-senha-sim

# --- Broker gerenciado (HiveMQ Cloud), em vez do Mosquitto local ---
# MQTT_URL=tls://SEU-CLUSTER.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=backend
# MQTT_PASSWORD=senha-criada-no-hivemq

# --- Telegram (crie o bot com @BotFather; descubra o chat id com @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Login do painel (recomendado quando estiver na nuvem) ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Regras de alerta ---
ALERT_SAMPLES=3
ALERT_REMINDER=5m
DEVICE_STALE_AFTER=30s
