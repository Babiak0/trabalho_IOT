    { "type": "wokwi-dht22", "id": "dht", "top": -48, "left": 220, "attrs": { "temperature": "24", "humidity": "50" } },
    { "type": "wokwi-led", "id": "fan", "top": 140, "left": 250, "attrs": { "color": "green", "label": "Ventilação" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 170, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "alarm", "top": 140, "left": 320, "attrs": { "color": "red", "label": "Alarme" } },
