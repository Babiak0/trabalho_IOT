    [ "fan:C", "esp:GND.2", "black", [] ],
    [ "esp:19", "r2:1", "orange", [] ],
    [ "r2:2", "alarm:A", "orange", [] ],
    [ "alarm:C", "esp:GND.2", "black", [] ]
